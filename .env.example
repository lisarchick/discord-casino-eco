# Токен бота: Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# ID сервера, чтобы slash-команды обновлялись сразу
GUILD_ID=
# Настройки экономики
START_BALANCE=1000
CLAIM_AMOUNT=100
CLAIM_COOLDOWN=3600
# Питомцы: XP за сообщение не чаще, чем раз в N секунд (0 = без XP за сообщения)
PET_MESSAGE_COOLDOWN=5
# Роль новым участникам автоматически (0 = выключено)
AUTO_JOIN_ROLE_ID=0
# Магазин ролей за монеты: roleId:цена через запятую
ROLE_SHOP=123456789012345678:7000,234567890123456789:3000
